{
  "name": "signal-null",
  "version": "0.1.0",
  "description": "SIGNAL NULL - A psychological text adventure",
  "main": "dist-electron/main/index.js",
  "author": "Signal Null Studio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:linux": "electron-vite build && electron-builder --linux",
    "test": "vitest run",
    "story:graph": "tsx scripts/generate-story-graph.ts"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "howler": "^2.2.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  },
  "build": {
    "appId": "com.signalnull.game",
    "productName": "SIGNAL NULL",
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "src/assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "SignalNull-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  }
}
